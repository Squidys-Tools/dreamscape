{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "Run desktop host",
      "command": "cargo run -p host-iced --release",
      "icon": "play"
    },
    {
      "name": "Run browser canvas",
      "command": ".\\scripts\\web-bench.ps1 -Scenario quick",
      "icon": "play"
    },
    {
      "name": "Probe surface (SQU-73)",
      "command": "cargo run -p probe-surface --release",
      "icon": "debug"
    },
    {
      "name": "Bench quick",
      "command": ".\\scripts\\bench.ps1 -Scenario quick",
      "icon": "play"
    },
    {
      "name": "Bench full sweep",
      "command": ".\\scripts\\bench.ps1",
      "icon": "play"
    },
    {
      "name": "Bench all on screen",
      "command": ".\\scripts\\bench.ps1 -Scenario scale",
      "icon": "play"
    },
    {
      "name": "Check before commit",
      "command": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets && cargo test --workspace --exclude canvas-wasm && cargo check -p canvas-wasm --target wasm32-unknown-unknown && cargo check -p canvas-wasm --target wasm32-unknown-unknown --features webgl",
      "icon": "lint"
    },
    {
      "name": "Format",
      "command": "cargo fmt --all",
      "icon": "configure"
    },
    {
      "name": "Clean worktree on settle",
      "command": "cargo clean",
      "icon": "configure",
      "runOnSettle": true
    }
  ]
}
